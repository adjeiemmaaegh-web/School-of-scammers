{
  "name": "plc-skills-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-offline.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:integration": "node scripts/check-integration-contracts.cjs",
    "verify:offline": "npm run check:integration && node scripts/test-integration-contracts.cjs",
    "verify:engineering:offline": "node scripts/verify-engineering-offline.cjs",
    "verify:full": "node scripts/verify-full-build.cjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.5",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "6.4.5",
    "vitest": "5.1.0"
  }
}
